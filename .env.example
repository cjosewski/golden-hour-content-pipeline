# Copy to .env if you use a dotenv-loading tool, or just set these as real
# environment variables — the pipeline reads the process environment; it does
# not load .env itself. NEVER commit .env (it is gitignored).
#
# Windows PowerShell:
#   $env:ANTHROPIC_API_KEY = "sk-ant-..."
#
# Only the live generation path needs the key. The retrieval self-test
# (`uv run python -m pipeline.selftest`) and the dry run
# (`uv run python -m pipeline --no-llm`) run fully offline with no key.

ANTHROPIC_API_KEY=your-key-here

# Optional override; this is the default used by the pipeline:
# MODEL=claude-sonnet-4-5
